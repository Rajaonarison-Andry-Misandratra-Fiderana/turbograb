# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# Sidecar binaries, fetched at build time — never committed.
# A 40 MB yt-dlp lived in this tree once and is still in the history of every
# clone. Git keeps what it is given, so the guard belongs here rather than in
# anyone's memory.
/binaries/
