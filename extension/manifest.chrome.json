{
  "manifest_version": 3,
  "name": "TurboGrab",
  "version": "0.1.0",
  "description": "Send browser downloads to TurboGrab: multi-connection transfers, real pause and resume.",
  "icons": {
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["downloads", "cookies", "storage", "contextMenus", "notifications", "alarms"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/icon-32.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
