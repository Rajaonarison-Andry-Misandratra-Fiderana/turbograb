{
  "name": "turbograb",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "npm run test:rust && npm run test:ext",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:ext": "node --test extension/test/",
    "ext": "scripts/build-extension.sh",
    "ext:lint": "web-ext lint --source-dir dist-extension/firefox --self-hosted",
    "ext:sign": "web-ext sign --source-dir dist-extension/firefox --artifacts-dir dist-extension/signed --channel=unlisted"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "web-ext": "^10.6.0"
  }
}
